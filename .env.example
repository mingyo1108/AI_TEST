# DB 접속 정보. 처음 한 번 `cp .env.example .env` 후 ./gradlew dbReset
# .env 는 커밋하지 않는다(.gitignore). 계정·비밀번호를 채팅에 입력하지 않는다.

# 개발 DB (읽기·쓰기). AI가 SQL을 실행해 보는 곳
DB_DEV_URL=jdbc:h2:file:./.local/db/dev;MODE=MSSQLServer
DB_DEV_USER=shop_dev
DB_DEV_PASSWORD=dev-local-1234

# 운영 흉내 DB (조회 전용 계정). 관리자 계정은 주지 않는다
DB_PROD_URL=jdbc:h2:file:./.local/db/prod;MODE=MSSQLServer
DB_PROD_USER=shop_ro
DB_PROD_PASSWORD=ro-local-1234
